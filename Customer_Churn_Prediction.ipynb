# ============================================================
# CUSTOMER CHURN PREDICTION
# ============================================================

# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    confusion_matrix,
    classification_report,
    roc_curve
)

import joblib


# ============================================================
# 2. LOAD DATASET
# ============================================================

df = pd.read_csv("WA_Fn-UseC_-Telco-Customer-Churn.csv")

print("Dataset loaded successfully!")

print("\nFirst 5 rows:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)


# ============================================================
# 3. BASIC DATA UNDERSTANDING
# ============================================================

print("\nColumn Names:")
print(df.columns)

print("\nData Types:")
print(df.dtypes)

print("\nDataset Information:")
print(df.info())

print("\nStatistical Summary:")
print(df.describe(include="all"))


# ============================================================
# 4. CHECK DUPLICATES
# ============================================================

print("\nNumber of duplicate rows:")
print(df.duplicated().sum())

df.drop_duplicates(inplace=True)

print("\nShape after removing duplicates:")
print(df.shape)


# ============================================================
# 5. CHECK MISSING VALUES
# ============================================================

print("\nMissing values:")
print(df.isnull().sum())


# ============================================================
# 6. CLEAN TOTALCHARGES
# ============================================================

# TotalCharges sometimes contains blank spaces.
# Convert it into numeric format.

df["TotalCharges"] = pd.to_numeric(
    df["TotalCharges"],
    errors="coerce"
)

print("\nMissing values after converting TotalCharges:")
print(df.isnull().sum())


# Fill missing TotalCharges using median

df["TotalCharges"] = df["TotalCharges"].fillna(
    df["TotalCharges"].median()
)


# ============================================================
# 7. REMOVE CUSTOMER ID
# ============================================================

# customerID does not help the ML model.

df.drop("customerID", axis=1, inplace=True)


# ============================================================
# 8. TARGET VARIABLE ENCODING
# ============================================================

# Churn:
# Yes = 1
# No  = 0

df["Churn"] = df["Churn"].map({
    "Yes": 1,
    "No": 0
})

print("\nChurn distribution:")
print(df["Churn"].value_counts())


# ============================================================
# 9. EDA - CHURN DISTRIBUTION
# ============================================================

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df,
    x="Churn"
)

plt.title("Customer Churn Distribution")
plt.xlabel("Churn")
plt.ylabel("Number of Customers")

plt.show()


# ============================================================
# 10. CHURN PERCENTAGE
# ============================================================

churn_percentage = (
    df["Churn"]
    .value_counts(normalize=True)
    * 100
)

print("\nChurn Percentage:")
print(churn_percentage)


# ============================================================
# 11. EDA - TENURE VS CHURN
# ============================================================

plt.figure(figsize=(8, 5))

sns.boxplot(
    data=df,
    x="Churn",
    y="tenure"
)

plt.title("Tenure vs Churn")

plt.show()


# ============================================================
# 12. EDA - MONTHLY CHARGES VS CHURN
# ============================================================

plt.figure(figsize=(8, 5))

sns.boxplot(
    data=df,
    x="Churn",
    y="MonthlyCharges"
)

plt.title("Monthly Charges vs Churn")

plt.show()


# ============================================================
# 13. EDA - CONTRACT TYPE VS CHURN
# ============================================================

plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="Contract",
    hue="Churn"
)

plt.title("Contract Type vs Churn")
plt.xticks(rotation=20)

plt.show()


# ============================================================
# 14. EDA - PAYMENT METHOD VS CHURN
# ============================================================

plt.figure(figsize=(10, 5))

sns.countplot(
    data=df,
    x="PaymentMethod",
    hue="Churn"
)

plt.title("Payment Method vs Churn")
plt.xticks(rotation=45, ha="right")

plt.show()


# ============================================================
# 15. EDA - INTERNET SERVICE VS CHURN
# ============================================================

plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="InternetService",
    hue="Churn"
)

plt.title("Internet Service vs Churn")

plt.show()


# ============================================================
# 16. FEATURE ENGINEERING
# ============================================================

# Create average monthly spending based on total charges
# and tenure.

df["AvgMonthlySpend"] = (
    df["TotalCharges"] /
    df["tenure"].replace(0, 1)
)

# Create tenure groups

df["TenureGroup"] = pd.cut(
    df["tenure"],
    bins=[-1, 12, 24, 48, 72],
    labels=[
        "0-1 Year",
        "1-2 Years",
        "2-4 Years",
        "4+ Years"
    ]
)

print("\nFeature engineered dataset:")
print(df.head())


# ============================================================
# 17. SEPARATE FEATURES AND TARGET
# ============================================================

X = df.drop("Churn", axis=1)

y = df["Churn"]

print("\nFeatures:")
print(X.columns)

print("\nTarget:")
print(y.name)


# ============================================================
# 18. ONE-HOT ENCODING
# ============================================================

X = pd.get_dummies(
    X,
    drop_first=True
)

print("\nShape after encoding:")
print(X.shape)

print("\nEncoded columns:")
print(X.columns)


# ============================================================
# 19. TRAIN TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining data shape:")
print(X_train.shape)

print("\nTesting data shape:")
print(X_test.shape)


# ============================================================
# 20. FEATURE SCALING
# ============================================================

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)

X_test_scaled = scaler.transform(X_test)


# ============================================================
# 21. LOGISTIC REGRESSION
# ============================================================

logistic_model = LogisticRegression(
    max_iter=1000,
    random_state=42
)

logistic_model.fit(
    X_train_scaled,
    y_train
)


# ============================================================
# 22. LOGISTIC REGRESSION PREDICTION
# ============================================================

y_pred_logistic = logistic_model.predict(
    X_test_scaled
)

y_prob_logistic = logistic_model.predict_proba(
    X_test_scaled
)[:, 1]


# ============================================================
# 23. LOGISTIC REGRESSION EVALUATION
# ============================================================

accuracy_lr = accuracy_score(
    y_test,
    y_pred_logistic
)

precision_lr = precision_score(
    y_test,
    y_pred_logistic
)

recall_lr = recall_score(
    y_test,
    y_pred_logistic
)

f1_lr = f1_score(
    y_test,
    y_pred_logistic
)

roc_auc_lr = roc_auc_score(
    y_test,
    y_prob_logistic
)


print("\n==============================")
print("LOGISTIC REGRESSION RESULTS")
print("==============================")

print("Accuracy :", accuracy_lr)
print("Precision:", precision_lr)
print("Recall   :", recall_lr)
print("F1 Score :", f1_lr)
print("ROC-AUC  :", roc_auc_lr)


# ============================================================
# 24. RANDOM FOREST MODEL
# ============================================================

rf_model = RandomForestClassifier(
    n_estimators=200,
    max_depth=10,
    min_samples_split=5,
    min_samples_leaf=2,
    random_state=42,
    class_weight="balanced"
)

rf_model.fit(
    X_train,
    y_train
)


# ============================================================
# 25. RANDOM FOREST PREDICTION
# ============================================================

y_pred_rf = rf_model.predict(
    X_test
)

y_prob_rf = rf_model.predict_proba(
    X_test
)[:, 1]


# ============================================================
# 26. RANDOM FOREST EVALUATION
# ============================================================

accuracy_rf = accuracy_score(
    y_test,
    y_pred_rf
)

precision_rf = precision_score(
    y_test,
    y_pred_rf
)

recall_rf = recall_score(
    y_test,
    y_pred_rf
)

f1_rf = f1_score(
    y_test,
    y_pred_rf
)

roc_auc_rf = roc_auc_score(
    y_test,
    y_prob_rf
)


print("\n==============================")
print("RANDOM FOREST RESULTS")
print("==============================")

print("Accuracy :", accuracy_rf)
print("Precision:", precision_rf)
print("Recall   :", recall_rf)
print("F1 Score :", f1_rf)
print("ROC-AUC  :", roc_auc_rf)


# ============================================================
# 27. MODEL COMPARISON
# ============================================================

results = pd.DataFrame({
    "Model": [
        "Logistic Regression",
        "Random Forest"
    ],

    "Accuracy": [
        accuracy_lr,
        accuracy_rf
    ],

    "Precision": [
        precision_lr,
        precision_rf
    ],

    "Recall": [
        recall_lr,
        recall_rf
    ],

    "F1 Score": [
        f1_lr,
        f1_rf
    ],

    "ROC-AUC": [
        roc_auc_lr,
        roc_auc_rf
    ]
})

print("\n==============================")
print("MODEL COMPARISON")
print("==============================")

print(results)


# ============================================================
# 28. CONFUSION MATRIX - LOGISTIC REGRESSION
# ============================================================

cm_lr = confusion_matrix(
    y_test,
    y_pred_logistic
)

plt.figure(figsize=(6, 5))

sns.heatmap(
    cm_lr,
    annot=True,
    fmt="d",
    cmap="Blues"
)

plt.title("Logistic Regression Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")

plt.show()


# ============================================================
# 29. CONFUSION MATRIX - RANDOM FOREST
# ============================================================

cm_rf = confusion_matrix(
    y_test,
    y_pred_rf
)

plt.figure(figsize=(6, 5))

sns.heatmap(
    cm_rf,
    annot=True,
    fmt="d",
    cmap="Greens"
)

plt.title("Random Forest Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")

plt.show()


# ============================================================
# 30. CLASSIFICATION REPORT
# ============================================================

print("\n==============================")
print("RANDOM FOREST CLASSIFICATION REPORT")
print("==============================")

print(
    classification_report(
        y_test,
        y_pred_rf
    )
)


# ============================================================
# 31. ROC CURVE
# ============================================================

fpr_lr, tpr_lr, thresholds_lr = roc_curve(
    y_test,
    y_prob_logistic
)

fpr_rf, tpr_rf, thresholds_rf = roc_curve(
    y_test,
    y_prob_rf
)


plt.figure(figsize=(8, 6))

plt.plot(
    fpr_lr,
    tpr_lr,
    label=f"Logistic Regression (AUC = {roc_auc_lr:.2f})"
)

plt.plot(
    fpr_rf,
    tpr_rf,
    label=f"Random Forest (AUC = {roc_auc_rf:.2f})"
)

plt.plot(
    [0, 1],
    [0, 1],
    linestyle="--"
)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")

plt.title("ROC Curve")

plt.legend()

plt.show()


# ============================================================
# 32. FEATURE IMPORTANCE - RANDOM FOREST
# ============================================================

feature_importance = pd.DataFrame({

    "Feature": X.columns,

    "Importance": rf_model.feature_importances_

})

feature_importance = feature_importance.sort_values(
    by="Importance",
    ascending=False
)


print("\n==============================")
print("TOP FEATURE IMPORTANCE")
print("==============================")

print(
    feature_importance.head(15)
)


# ============================================================
# 33. FEATURE IMPORTANCE VISUALIZATION
# ============================================================

top_features = feature_importance.head(15)

plt.figure(figsize=(10, 7))

sns.barplot(
    data=top_features,
    x="Importance",
    y="Feature"
)

plt.title("Top 15 Customer Churn Drivers")

plt.xlabel("Feature Importance")

plt.ylabel("Feature")

plt.show()


# ============================================================
# 34. LOGISTIC REGRESSION COEFFICIENT ANALYSIS
# ============================================================

coefficients = pd.DataFrame({

    "Feature": X.columns,

    "Coefficient": logistic_model.coef_[0]

})

coefficients["AbsoluteCoefficient"] = (
    coefficients["Coefficient"].abs()
)

coefficients = coefficients.sort_values(
    by="AbsoluteCoefficient",
    ascending=False
)


print("\n==============================")
print("LOGISTIC REGRESSION COEFFICIENTS")
print("==============================")

print(
    coefficients.head(15)
)


# ============================================================
# 35. TOP CHURN DRIVERS
# ============================================================

print("\n==============================")
print("TOP CHURN DRIVERS")
print("==============================")

print(
    feature_importance.head(10)
)


# ============================================================
# 36. PREDICT A NEW CUSTOMER
# ============================================================

# Example customer

new_customer = pd.DataFrame({

    "gender": ["Male"],

    "SeniorCitizen": [0],

    "Partner": ["No"],

    "Dependents": ["No"],

    "tenure": [5],

    "PhoneService": ["Yes"],

    "MultipleLines": ["No"],

    "InternetService": ["Fiber optic"],

    "OnlineSecurity": ["No"],

    "OnlineBackup": ["No"],

    "DeviceProtection": ["No"],

    "TechSupport": ["No"],

    "StreamingTV": ["Yes"],

    "StreamingMovies": ["Yes"],

    "Contract": ["Month-to-month"],

    "PaperlessBilling": ["Yes"],

    "PaymentMethod": [
        "Electronic check"
    ],

    "MonthlyCharges": [85.0],

    "TotalCharges": [425.0]

})


# Feature engineering for new customer

new_customer["AvgMonthlySpend"] = (
    new_customer["TotalCharges"] /
    new_customer["tenure"].replace(0, 1)
)

new_customer["TenureGroup"] = pd.cut(
    new_customer["tenure"],
    bins=[-1, 12, 24, 48, 72],
    labels=[
        "0-1 Year",
        "1-2 Years",
        "2-4 Years",
        "4+ Years"
    ]
)


# Encode new customer

new_customer_encoded = pd.get_dummies(
    new_customer,
    drop_first=True
)


# Make sure new customer has exactly
# the same columns as training data

new_customer_encoded = new_customer_encoded.reindex(
    columns=X.columns,
    fill_value=False
)


# Convert to same data type

new_customer_encoded = new_customer_encoded.astype(float)


# Predict churn

new_customer_prediction = rf_model.predict(
    new_customer_encoded
)

new_customer_probability = rf_model.predict_proba(
    new_customer_encoded
)[:, 1]


print("\n==============================")
print("NEW CUSTOMER PREDICTION")
print("==============================")


if new_customer_prediction[0] == 1:

    print("Prediction: Customer is likely to CHURN")

else:

    print("Prediction: Customer is likely to STAY")


print(
    f"Churn Probability: "
    f"{new_customer_probability[0] * 100:.2f}%"
)


# ============================================================
# 37. SAVE MODEL
# ============================================================

joblib.dump(
    rf_model,
    "customer_churn_random_forest.pkl"
)

joblib.dump(
    scaler,
    "customer_churn_scaler.pkl"
)

joblib.dump(
    X.columns.tolist(),
    "customer_churn_features.pkl"
)


print("\nModel saved successfully!")


# ============================================================
# 38. FINAL SUMMARY
# ============================================================

print("\n========================================")
print("CUSTOMER CHURN PROJECT COMPLETED")
print("========================================")

print(f"Dataset Records: {len(df)}")

print(
    f"Logistic Regression Accuracy: "
    f"{accuracy_lr * 100:.2f}%"
)

print(
    f"Random Forest Accuracy: "
    f"{accuracy_rf * 100:.2f}%"
)

print(
    f"Random Forest ROC-AUC: "
    f"{roc_auc_rf:.2f}"
)

print("\nTop 5 Churn Drivers:")

print(
    feature_importance.head(5)
)
